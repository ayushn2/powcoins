#!/usr/bin/env python3
"""Pool payout service for ckpool miners.

Watches a wallet for incoming coins (block rewards or powcoins claims),
matches each to a solving share in ckpool's sharelogs, and distributes
rewards to miners using a carryover geometric score model with
work-clock decay.

See pooled-payouts-carryover-geometric-spec.md for the full design.
"""

import argparse
import bisect
import collections
from decimal import Decimal
import hashlib
import json
import logging
import math
import os
import sqlite3
import struct
import subprocess
import time

# -- Parameters ---------------------------------------------------------------

MINDIFF = 0.1                 # work counter quantization (default)
SETTLE_DEPTH_POWCOINS = 12
SETTLE_DEPTH_COINBASE = 100
MARGIN_FRACTION = 0.02        # 2% pool margin
DUST_THRESHOLD = 1000         # sats; sub-threshold goes to lottery
MIN_PAYOUT_VALUE = 10_000_000 # sats (0.1 BTC); defer payout if total settled below this
FEE_RATE = 1                  # sat/vB; None to use wallet fee estimation
WORKSTAMP_EPOCH_THRESHOLD = 2**62
WORKSTAMP_EPOCH_ADJUSTMENT = 2**61
L_OVER_MINDIFF_LIMIT = 2**57

# -- Helpers ------------------------------------------------------------------

STDIN_THRESHOLD = 500  # bytes; arguments larger than this go via -stdin

def bitcoin_cli(basecmd, args, **kwargs):
    # Move large arguments to stdin to avoid E2BIG
    if any(len(a) > STDIN_THRESHOLD for a in args):
        # Find the first large arg — it and everything after go to stdin
        split = next(i for i, a in enumerate(args) if len(a) > STDIN_THRESHOLD)
        cmd = basecmd + ["-stdin"] + args[:split]
        stdin_data = "\n".join(args[split:]) + "\n"
        kwargs["input"] = stdin_data.encode()
    else:
        cmd = basecmd + args
    out = subprocess.run(cmd, stdout=subprocess.PIPE, **kwargs, check=True).stdout
    if isinstance(out, bytes):
        out = out.decode('utf8')
    return out.strip()

def btc_to_sats(btc):
    """Convert BTC (float or string) to satoshis without float truncation."""
    return int(Decimal(str(btc)).quantize(Decimal('1e-8')) * Decimal('100000000'))

def sha256(data):
    return hashlib.sha256(data).digest()

def hash256(data):
    return sha256(sha256(data))

def bcli_json(bcli, *args):
    return json.loads(bcli(*args))

def nbits_to_ndiff(nbits):
    """Convert compact target (nbits) to network difficulty."""
    exponent = (nbits >> 24) & 0xff
    mantissa = nbits & 0x7fffff
    if exponent <= 3:
        target = mantissa >> (8 * (3 - exponent))
    else:
        target = mantissa << (8 * (exponent - 3))
    if target <= 0:
        return float('inf')
    return (0xFFFF << 208) / target

def load_workinfo_cache(logs_dir):
    """Build filename_stem → (ndiff, reward) cache from workinfo files.

    Each sharelog file shares a filename stem with its workinfo file,
    so we key the cache by stem (e.g. '6a319d3c000032fb').
    """
    cache = {}
    for height_dir in os.listdir(logs_dir):
        dirpath = os.path.join(logs_dir, height_dir)
        if not os.path.isdir(dirpath):
            continue
        for fname in os.listdir(dirpath):
            if not fname.endswith('.workinfo'):
                continue
            fpath = os.path.join(dirpath, fname)
            with open(fpath) as f:
                info = json.loads(f.readline())
            nbits = int(info["bits"], 16)
            stem = fname[:-len('.workinfo')]
            cache[stem] = (nbits_to_ndiff(nbits), info.get("reward"))
    return cache

